# ==========================================
# MeetFlow AI — Environment Configuration
# ==========================================

# Application Environment (development, staging, production)
APP_ENV=development
DEBUG=true

# Database Configuration
# For local development with SQLite fallback:
DATABASE_URL=sqlite+aiosqlite:///./meetflow.db
# For PostgreSQL in production or local docker:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/meetflow

# Security & Authentication
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# NVIDIA NIM Hosted LLM Integration
# Get an API key from https://build.nvidia.com/
NVIDIA_API_KEY=your_real_nvidia_nim_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct
NVIDIA_TIMEOUT_SECONDS=90
NVIDIA_MAX_RETRIES=3

# Frontend & Backend URLs (CORS & Redirection)
FRONTEND_URL=http://localhost:5173
BACKEND_PUBLIC_URL=http://localhost:8000

# File Upload Constraints
UPLOAD_MAX_SIZE_MB=10
ALLOWED_EXTENSIONS=txt,pdf,docx

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
AI_RATE_LIMIT_PER_MINUTE=10

